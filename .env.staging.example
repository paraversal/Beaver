# Copy to .env.staging for tests. Use a separate test bot/group and DB so tests
# never touch the production supergroup.
APP_ENV=staging
BOT_TOKEN=123456789:replace-with-a-test-bot-token

# Any group the bot is an admin in. A plain group works; a forum is fine too.
SUPPORT_CHAT_ID=-1000000000001

# Optional. Leave unset (or 0) for a plain group: tickets then live in the group
# itself. Only set this for a forum, and only if tickets must go to one topic
# instead of General.
# TICKETS_TOPIC_ID=

ADMIN_IDS=

SECRET_QUESTION=What is the name of the city our university is located in?
SECRETS=answer one,answer two

DB_PATH=data/beaver-staging.db
LOG_LEVEL=INFO
TIMEZONE=UTC
