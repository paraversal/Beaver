# Copy to .env and fill every value. Never commit the real file.
APP_ENV=production
BOT_TOKEN=123456789:replace-with-your-botfather-token

# Group where tickets are posted. A private supergroup with Topics enabled is the
# recommended setup: create one Tickets topic and put its thread ID below. A plain
# group (or a supergroup without Topics) also works — then leave TICKETS_TOPIC_ID
# unset and tickets go into the chat itself.
# SUPERGROUP_ID is accepted as a legacy alias; do not set both to different values.
SUPPORT_CHAT_ID=-1000000000000

# Optional positive thread ID of the Tickets topic. Comment out to use the whole
# chat (required for plain groups, must not be a General/thread 1 setting).
TICKETS_TOPIC_ID=12345

# Optional bootstrap/owner IDs, comma separated. Group admins are picked up
# automatically.
ADMIN_IDS=

SECRET_QUESTION=What is the name of the city our university is located in?
SECRETS=answer one,answer two

DB_PATH=data/beaver.db
LOG_LEVEL=INFO
TIMEZONE=UTC
